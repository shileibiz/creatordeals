---
import { SITE_URL } from '../../astro.config.mjs';
const {title,description,lang='en',alternates={},crumbs=[],schema=[]}=Astro.props;
const path=Astro.url.pathname;
const canonical=new URL(path,SITE_URL).href;
const links=Object.entries(alternates);
const breadcrumb=crumbs.length ? {'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:crumbs.map((c,i)=>({'@type':'ListItem',position:i+1,name:c.name,item:new URL(c.path,SITE_URL).href}))}:null;
const pageSchema={'@context':'https://schema.org','@type':'WebPage',name:title,description,url:canonical,inLanguage:lang};
const graph=[pageSchema,...schema,...(breadcrumb?[breadcrumb]:[])];
---
<!doctype html><html lang={lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/>{links.map(([code,p])=><link rel="alternate" hreflang={code} href={new URL(p,SITE_URL).href}/>)}<meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL('/og.svg',SITE_URL).href}/>{graph.map((item)=><script type="application/ld+json" set:html={JSON.stringify(item)} />)}<link rel="icon" href="/favicon.svg"/></head><body><header><a class="brand" href="/">CreatorDeals</a><nav aria-label="Main"><a href="/category/video/">Video</a><a href="/category/audio/">Audio</a><a href="/category/ai/">AI tools</a><a href="/guide/save-on-creator-tools/">Buying guide</a><a href="/about/">About</a></nav></header><main><slot/></main><footer><p>Independent buying research. No verified coupon codes are listed yet.</p><p><a href="/about/">Editorial policy & affiliate disclosure</a> · <a href="/de/">Deutsch</a> · <a href="/ja/">日本語</a></p></footer></body></html>
<style is:global>
:root{font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#15322f;background:#f5f7f2}*{box-sizing:border-box}body{margin:0}a{color:#0b6159}a:hover{text-decoration-thickness:2px}header,footer{padding:1.2rem max(1.2rem,calc((100vw - 1100px)/2));background:#143d37;color:white}header{display:flex;align-items:center;gap:2rem;flex-wrap:wrap}header a,footer a{color:#d5fff0}.brand{font-size:1.35rem;font-weight:800;text-decoration:none}nav{display:flex;flex-wrap:wrap;gap:1rem}main{max-width:1100px;margin:auto;padding:2.5rem 1.2rem 5rem;min-height:65vh}h1{font-size:clamp(2rem,5vw,3.4rem);line-height:1.12}h2{margin-top:2.5rem}.lead{font-size:1.2rem;max-width:70ch;line-height:1.55}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:1rem}.card{background:white;border:1px solid #dce5dc;border-radius:14px;padding:1.3rem;box-shadow:0 3px 15px #15322f0a}.card h2,.card h3{margin:.2rem 0}.muted{color:#526660}.badge{display:inline-block;background:#e6f3e9;border-radius:99px;padding:.25rem .65rem;font-size:.8rem}p,li{line-height:1.7}section{margin:2rem 0}.notice{padding:1rem 1.3rem;background:#fff5df;border-left:4px solid #bf7a14}.prose{max-width:76ch}.prose p{line-height:1.85}table{border-collapse:collapse;width:100%}td,th{padding:.8rem;border-bottom:1px solid #cfdbd4;text-align:left}footer{font-size:.9rem}
</style>
