---
import Base from '../../layouts/Base.astro';
export function getStaticPaths(){return Object.values(import.meta.glob('../../../data/merchants/*.json',{eager:true,import:'default'})).map(m=>({params:{slug:m.slug},props:{m}}));}
const {m}=Astro.props;
const translated=['movavi','filmora','camtasia'].includes(m.slug);
const alternates=translated?{en:`/store/${m.slug}/`,de:`/de/store/${m.slug}/`,ja:`/ja/store/${m.slug}/`,'x-default':`/store/${m.slug}/`}:{};
const faq=[{q:`Are there verified ${m.name} coupon codes here?`,a:'No. We have not verified an active code or public offer for this merchant.'},{q:'How should I check the final price?',a:'Open the official merchant checkout, review renewal and license terms, and save the date and offer conditions before purchase.'}];
const faqSchema={'@context':'https://schema.org','@type':'FAQPage',mainEntity:faq.map(x=>({'@type':'Question',name:x.q,acceptedAnswer:{'@type':'Answer',text:x.a}}))};
const offers=m.offers.map(o=>({'@context':'https://schema.org','@type':'Offer',name:o.title,url:o.source_url,validThrough:o.expires_at,availability:'https://schema.org/InStock', ...(o.code?{description:`Code: ${o.code}`}:{description:'No code required'})}));
---
<Base title={`${m.name} deals & buying guide | CreatorDeals`} description={`Independent ${m.name} buying guide for ${m.focus}. Check verified offers, source dates and practical evaluation steps.`} alternates={alternates} schema={[faqSchema,...offers]} crumbs={[{name:'Home',path:'/'},{name:m.name,path:`/store/${m.slug}/`}]}><p class="notice">Disclosure: CreatorDeals may earn a commission from future affiliate links; none are active on this page. <a href="/about/">Read our affiliate disclosure</a>.</p><p><a href="/">Home</a> / {m.name}</p><h1>{m.name}: offers and buying guide</h1><p class="lead">A practical evaluation of {m.focus}, with source and verification dates attached.</p><section><h2>Current verified offers</h2>{m.offers.length?m.offers.map(o=><article class="card"><h3>{o.title}</h3><p>{o.code?`Code: ${o.code}`:'No code required'}</p><p>Last verified: {o.verified_at}</p><a href={o.source_url} rel="sponsored nofollow noopener">Official offer source</a></article>):<p class="notice">No active public offer is verified. We will add one only after checking its terms and source.</p>}</section><details><summary>Expired offers ({m.expired.length})</summary>{m.expired.length?m.expired.map(o=><p>{o.title} — expired {o.expires_at}</p>):<p>No expired offers recorded.</p>}</details><section class="prose"><h2>Our independent buying notes</h2><p>{m.editorial}</p></section><section><h2>Policy checks</h2><ul><li>Refunds: {m.refund_policy}</li><li>Student pricing: {m.student_pricing}</li><li>Seasonal promotions: {m.seasonality}</li></ul><p>Official source: <a href={m.source_url} rel="sponsored nofollow noopener">{m.source_url}</a>. Checked {m.fetched_date}. These fields are left unverified until we have a supporting official source.</p></section><section><h2>Questions</h2>{faq.map(x=><div><h3>{x.q}</h3><p>{x.a}</p></div>)}</section></Base>
