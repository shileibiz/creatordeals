---
import Base from '../../../layouts/Base.astro';
export function getStaticPaths(){return ['movavi','filmora','camtasia'].map(slug=>({params:{slug},props:{m:Object.values(import.meta.glob('../../../../data/merchants/*.json',{eager:true,import:'default'})).find(x=>x.slug===slug)}}));}
const {m}=Astro.props;const p=`/store/${m.slug}/`;const alternates={en:p,de:`/de${p}`,ja:`/ja${p}`,'x-default':p};
---
<Base lang="ja" title={`${m.name} の購入ガイドと特典 | CreatorDeals`} description={`${m.name}の公式情報、確認日、購入前に確認したい事項を掲載します。未確認のクーポンは載せません。`} alternates={alternates} crumbs={[{name:'ホーム',path:'/ja/'},{name:m.name,path:`/ja${p}`}]}><p class="notice">開示: CreatorDeals は今後アフィリエイトリンクから報酬を得る場合があります。このページに有効なアフィリエイトリンクはありません。<a href="/about/">アフィリエイト開示（英語）</a>。</p><h1>{m.name} の購入ガイド</h1><p class="lead">現在、確認済みの特典はありません。未確認のクーポンコードは掲載しません。</p><p>購入前に、価格、更新条件、ライセンスを販売元で確認してください。公式情報: <a href={m.source_url} rel="sponsored nofollow noopener">{m.source_url}</a>。確認日: {m.fetched_date}。</p><p><a href={p}>英語の詳しい購入ガイド</a></p></Base>
